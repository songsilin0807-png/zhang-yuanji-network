[{"name": "张元济", "alias": "菊生、张菊生、元济、菊翁、菊老", "intro": "张元济（1867—1959），字筱斋，号菊生，浙江海盐人。清光绪壬辰（1892）年进士，授翰林院庶吉士，曾任清廷刑部贵州司主事、总理各国事务衙门章京。戊戌变法失败后投身教育出版事业，1903年入商务印书馆，历任编译所所长、经理、监理、董事长，主持商务五十余年，提出\"昌明教育、开启民智\"宗旨，推动商务发展为中国现代出版巨擘。亲自主持《四部丛刊》《百衲本二十四史》等大型古籍出版，被誉为中国近代出版第一人、出版家、教育家、文献学家。", "letter_count": 979}, {"name": "刘承幹", "alias": "翰怡、刘翰怡、刘承軒、刘承韓、贞一", "intro": "刘承幹：(1882—1963), 字贞一, 号翰怡, 浙江上虞人, 藏书家, 南浔嘉业堂主人。", "letter_count": 275}, {"name": "孙毓修", "alias": "星如、孙星如、孙镜修、孙毓修雨", "intro": "孙毓修：(1871—1923), 字星如, 江苏无锡人。", "letter_count": 157}, {"name": "张树源", "alias": "伯远", "intro": "字号伯远", "letter_count": 156}, {"name": "顾廷龙", "alias": "", "intro": "燕京大学图书馆研究员，目录学家", "letter_count": 91}, {"name": "张家昌", "alias": "", "intro": "暂无简介", "letter_count": 88}, {"name": "朱希祖", "alias": "逖先、朱逖先、逃先、邁先、逊先", "intro": "朱希祖：(1879—1944)，字逖先，", "letter_count": 62}, {"name": "李宜龚", "alias": "拔可", "intro": "暂无简介", "letter_count": 56}, {"name": "高凤池", "alias": "", "intro": "商务印书馆创办人之一，时因病在山上养病", "letter_count": 54}, {"name": "陈敬第", "alias": "叔通", "intro": "字号叔通", "letter_count": 52}, {"name": "叶恭绰", "alias": "誉虎、叶誉虎、玉虎、叶玉虎、叶总长", "intro": "叶恭绰：(1880—1968), 字玉虎、誉虎, 广东番禺人, 民国政要、学者。", "letter_count": 50}, {"name": "汪康年", "alias": "穰卿", "intro": "字号穰卿", "letter_count": 49}, {"name": "孙伯恒", "alias": "伯恒、孙伯恒", "intro": "暂无简介", "letter_count": 46}, {"name": "李拔可", "alias": "拔可、李拔翁、拔翁", "intro": "李宣龚（1876—1953），字拔可，号观槿，又号墨巢，福建闽县（今福州）人。清光绪二十年（1894）甲午举人，曾任湖南桃源知县、江苏候补知府。民国后供职商务印书馆近40年，曾任经理兼发行所所长，与张元济、高凤池、高梦旦等合称\"商务四老\"。能诗工书法，喜收藏，著有《硕果亭诗》等。", "letter_count": 43}, {"name": "孙壮", "alias": "孙壮", "intro": "暂无简介", "letter_count": 41}, {"name": "夏敬观", "alias": "", "intro": "近代诗人、词人，号剑丞", "letter_count": 39}, {"name": "盛宣怀", "alias": "", "intro": "南洋公学督办", "letter_count": 38}, {"name": "傅增湘", "alias": "沅叔、傅沅叔", "intro": "藏书家，字沅叔", "letter_count": 34}, {"name": "汪兆镛", "alias": "憬吾", "intro": "字号憬吾", "letter_count": 34}, {"name": "王云五", "alias": "岫庐、王岫庐、帷庐、崎庐、嵡庐", "intro": "王云五（1888—1979），名鸿桢、字日祥、号岫庐，广东香山（今中山）人，生于上海。近代出版家，